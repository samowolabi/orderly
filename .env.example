# DELIVERY_FEE_PER_KM=150
# DELIVERY_FEE_ROUND_TO=100
# DELIVERY_MAX_KM=        (empty means no limit)
# DELIVERY_PREP_MINUTES=20
# DELIVERY_QUOTE_MINUTES=30
