DATABASE_URL=postgres://orderly:choose-a-dev-password@localhost:5433/orderly
GOOGLE_MAPS_API_KEY=replace_with_google_maps_key
# Fallback geocoder, used only when GOOGLE_MAPS_API_KEY is empty:
# GEOAPIFY_API_KEY=replace_with_geoapify_key
PAYSTACK_SECRET_KEY=sk_test_replace_me
BUYER_API_KEY=replace_with_random_string
SELLER_API_KEY=replace_with_random_string
BUSINESS_NAME=Kola Gadgets
BUSINESS_COUNTRY=NG
BUSINESS_CURRENCY=NGN
BUSINESS_LOCALE=en-NG
BUSINESS_TIMEZONE=Africa/Lagos
# Required when NODE_ENV=production, unless the host sets its own URL (Render, Railway):
# PUBLIC_URL=https://orderly.onrender.com
PORT=3000
