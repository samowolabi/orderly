DATABASE_URL=postgres://orderly:choose-a-dev-password@localhost:5433/orderly
GOOGLE_MAPS_API_KEY=replace_with_google_maps_key
PAYSTACK_SECRET_KEY=sk_test_replace_me
# Owner email alerts (optional). OWNER_EMAIL must be your Resend account's address until a domain is verified:
# RESEND_API_KEY=re_replace_me
# OWNER_EMAIL=you@example.com
BUYER_API_KEY=replace_with_random_string
SELLER_API_KEY=replace_with_random_string
BUSINESS_NAME=Kola Gadgets
BUSINESS_COUNTRY=NG
BUSINESS_CURRENCY=NGN
BUSINESS_LOCALE=en-NG
BUSINESS_TIMEZONE=Africa/Lagos
# Required when NODE_ENV=production, unless the host sets its own URL (Render, Railway):
# PUBLIC_URL=https://orderly.onrender.com
PORT=3000
# Default delivery pricing until the owner sets it by chat, in the business currency's main unit:
# DELIVERY_BASE_FEE=1500
# DELIVERY_FEE_PER_KM=150
# DELIVERY_FEE_ROUND_TO=100
# DELIVERY_MAX_KM=        (empty means no limit)
# DELIVERY_PREP_MINUTES=20
# DELIVERY_TRANSFER_MINUTES=60
# DELIVERY_QUOTE_MINUTES=30
