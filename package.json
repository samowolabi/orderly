{
  "name": "orderly",
  "version": "1.0.0",
  "description": "Orderly REST API: WhatsApp store for Kola Gadgets, called by Chord teammates",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "openapi": "tsx src/openapi/write.ts",
    "fake-paystack": "tsx dev/fake-paystack.ts",
    "fake-google": "tsx dev/fake-google.ts",
    "fake-resend": "tsx dev/fake-resend.ts",
    "test:api": "bash dev/curl-tests.sh",
    "test:geocoding": "tsx dev/geocoding-tests.ts",
    "test:hours": "tsx dev/hours-tests.ts",
    "test:location": "tsx dev/location-tests.ts",
    "test:retry": "tsx dev/retry-tests.ts",
    "db:create": "bash dev/create-local-db.sh"
  },
  "author": "Samuel Owolabi",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
